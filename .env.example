DATABASE_URL=postgresql://user:password@localhost:5432/dreamline
# Neon: use the pooled URL for DATABASE_URL on Vercel
AUTH_SECRET=generate-a-long-random-string
# Production (Vercel): set to your deployment URL, e.g. https://your-app.vercel.app
AUTH_URL=
DEMO_MODE=false
DEMO_STORE=false

# DEMO_MODE=true only for local prototyping that skips forced login.
# Leave DEMO_MODE unset or false so visitors must sign in.

# AI providers — set these to enable live OpenAI (leave empty for mocks)
AI_API_KEY=
AI_TRANSCRIPTION_API_KEY=
AI_IMAGE_API_KEY=

# Realtime soft voice uses AI_API_KEY via /api/dreams/realtime-session (voice: shimmer)
# Image generation uses gpt-image-1 via AI_IMAGE_API_KEY (or AI_API_KEY)

# Object storage — private Vercel Blob (auto-on when token is set)
BLOB_READ_WRITE_TOKEN=
STORAGE_TOKEN=
USE_VERCEL_BLOB=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH=false

# Set true to show demo seed tools in Settings
NEXT_PUBLIC_DEMO_TOOLS=false

# Password reset email (optional — without this, reset links are logged / shown in dev)
RESEND_API_KEY=
EMAIL_FROM=dreamweava <onboarding@resend.dev>
# Set true to return reset links in API responses (local testing only)
EXPOSE_RESET_LINK=false
