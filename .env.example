DATABASE_URL=postgresql://user:password@localhost:5432/dreamline
AUTH_SECRET=generate-a-long-random-string
DEMO_MODE=true
DEMO_STORE=true

# AI providers — set these to enable live OpenAI (leave empty for mocks)
AI_API_KEY=
AI_TRANSCRIPTION_API_KEY=
AI_IMAGE_API_KEY=

# Realtime soft voice uses AI_API_KEY via /api/dreams/realtime-session (voice: shimmer)
# Image generation uses gpt-image-1 via AI_IMAGE_API_KEY (or AI_API_KEY)

# Object storage (local filesystem used when unset / USE_VERCEL_BLOB!=true)
STORAGE_TOKEN=
BLOB_READ_WRITE_TOKEN=
USE_VERCEL_BLOB=false

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
